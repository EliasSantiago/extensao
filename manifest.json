{
  "manifest_version": 3,
  "name": "Nexo — Assistente de IA multi-modelo",
  "short_name": "Nexo",
  "version": "1.3.0",
  "description": "Assistente de IA no painel lateral que navega e age nos sites por você. OpenAI, Claude, Gemini e modelos locais (Ollama, LM Studio, vLLM).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir o Nexo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "contextMenus", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Abrir o Nexo"
    }
  }
}
